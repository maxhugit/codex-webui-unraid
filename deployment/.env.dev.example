# Installation de recette entièrement séparée de la production.
DEPLOY_ROOT=/mnt/pool/appdata/mergeron-dev
STATE_ROOT=/mnt/pool/appdata/mergeron-dev/state
UNRAID_APPDATA_ROOT=/mnt/user/appdata
MERGERON_STACK_PREFIX=mergeron-dev
MERGERON_STACK_ENVIRONMENT=development
MERGERON_ADMIN_SUBNET=172.30.44.16/28

# Pour tester une PR, remplacer les deux tags par son tag immuable sha-<commit>.
MERGERON_APP_IMAGE=ghcr.io/maxhugit/mergeron:edge
MERGERON_MANAGER_IMAGE=ghcr.io/maxhugit/mergeron-manager:edge
MERGERON_INGRESS_IMAGE=nginx:stable
MERGERON_EGRESS_IMAGE=ubuntu/squid:latest

MERGERON_WEBUI_URL=https://mergeron-dev.example.com
MERGERON_ICON_URL=https://raw.githubusercontent.com/maxhugit/mergeron/main/web/public/pwa-icon-192.png
