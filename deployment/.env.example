# Chemins sur l'hôte Unraid
DEPLOY_ROOT=/mnt/pool/appdata/codex-web/deployment
STATE_ROOT=/mnt/pool/appdata/codex-webui-limlll/state
UNRAID_APPDATA_ROOT=/mnt/user/appdata

# Images. Pour une restauration reproductible, remplacer latest par un tag sha-...
CODEX_APP_IMAGE=ghcr.io/maxhugit/codex-webui-unraid:latest
CODEX_INGRESS_IMAGE=nginx:stable
CODEX_EGRESS_IMAGE=ubuntu/squid:latest

# Intégration à l’interface Unraid Compose Manager
CODEX_WEBUI_URL=https://codex.example.com
CODEX_ICON_URL=https://raw.githubusercontent.com/maxhugit/codex-webui-unraid/main/web/public/pwa-icon-192.png
