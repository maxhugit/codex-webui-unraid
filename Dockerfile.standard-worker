# Separate, minimal execution image: no app database, SSH, MCP or account state.
FROM node:22-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap util-linux python3 python3-docx python3-openpyxl python3-pypdf \
    python3-reportlab bash \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 11003 standard-worker \
    && useradd --uid 11003 --gid 11003 --no-create-home standard-worker \
    && mkdir /workspaces && chown 11003:11003 /workspaces
WORKDIR /app
COPY scripts/sandbox/ /app/scripts/sandbox/
USER 11003:11003
ENV NODE_ENV=production
CMD ["node", "/app/scripts/sandbox/standard-worker.cjs"]
